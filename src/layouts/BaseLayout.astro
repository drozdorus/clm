---
// BaseLayout — <head> driven by props so each page sets its own SEO/OG/twitter
// values. One global stylesheet (style.css) and one global script (script.js) —
// the old per-page blog.css/team.css split was loaded on every page anyway.
// Page body goes in the default <slot />; page-specific <head> additions
// (e.g. JSON-LD) go in the named "head" slot.
import '../styles/style.css';

export interface Props {
  title: string;
  description: string;
  canonical: string;
  /** index, follow by default */
  robots?: string;
  /** homepage-only keywords meta; omit elsewhere */
  keywords?: string;
  ogType?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
  /** extra class on <body> */
  bodyClass?: string;
  /** id on <body> (homepage uses id="top") */
  bodyId?: string;
}

const {
  title,
  description,
  canonical,
  robots = 'index, follow',
  keywords,
  ogType = 'website',
  ogTitle,
  ogDescription,
  ogImage = 'https://calma.io/img/metaimg.png',
  twitterTitle,
  twitterDescription,
  twitterImage,
  bodyClass,
  bodyId,
} = Astro.props;

const ogTitleFinal = ogTitle ?? title;
const ogDescriptionFinal = ogDescription ?? description;
const twitterTitleFinal = twitterTitle ?? ogTitleFinal;
const twitterDescriptionFinal = twitterDescription ?? ogDescriptionFinal;
const twitterImageFinal = twitterImage ?? ogImage;
---

<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <link rel="canonical" href={canonical} />
  <link rel="preload" href="/fonts/geologica-vf-latin.woff2" as="font" type="font/woff2" crossorigin />
  <title>{title}</title>

  <!-- Favicons -->
  <link rel="icon" type="image/png" href="/img/favicon/favicon-32x32.png" sizes="32x32" />
  <link rel="icon" type="image/png" href="/img/favicon/favicon-16x16.png" sizes="16x16" />
  <link rel="apple-touch-icon" href="/img/favicon/apple-icon-180x180.png" />

  <!-- Meta Tags -->
  <meta name="description" content={description} />
  {keywords && <meta name="keywords" content={keywords} />}
  <meta name="robots" content={robots} />
  <meta name="author" content="Calma" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content="Calma" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={ogTitleFinal} />
  <meta property="og:description" content={ogDescriptionFinal} />
  <meta property="og:image" content={ogImage} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonical} />
  <meta name="twitter:title" content={twitterTitleFinal} />
  <meta name="twitter:description" content={twitterDescriptionFinal} />
  <meta name="twitter:image" content={twitterImageFinal} />

  <!-- Page-specific head (e.g. JSON-LD) -->
  <slot name="head" />
</head>

<body id={bodyId} class={bodyClass}>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <slot />

  <script>
    import '../scripts/script.js';
  </script>
</body>

</html>
