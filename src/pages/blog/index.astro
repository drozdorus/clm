---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/blog/ArticleCard.astro';

// Newest first; ties resolved by `order` (lower first).
const posts = (await getCollection('blog')).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.data.order - b.data.order
);
---

<BaseLayout
  title="Blog — Calma"
  description="Perspectives on performance marketing and lead generation across insurance, financial, and home services."
  canonical="https://calma.io/blog/"
  ogTitle="Calma Blog"
  ogDescription="Perspectives on performance marketing and lead generation."
>
  <Header />

  <main id="main-content">
    <div class="article-page">
      <div class="container">

        <Breadcrumb items={[{ label: 'Blog' }]} />

        <PageHero title="Blog" subtitle="Perspectives on performance marketing and lead generation" />

        <div class="blog-grid">
          {posts.map((post) => <ArticleCard post={post} headingLevel="h2" />)}
        </div>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
