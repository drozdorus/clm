---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import IconSprite from '../../components/IconSprite.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PageHero from '../../components/PageHero.astro';

// Mirrors the homepage "What We Do" block. A link exists wherever there is a
// dedicated page: sub-niches for insurance (auto, home), the group itself for
// home services and finance.
const groups = [
  {
    icon: 'icon-shield',
    title: 'Insurance',
    href: null,
    items: [
      { label: 'Auto', href: '/lead-generation/auto-insurance/' },
      { label: 'Home', href: '/lead-generation/home-insurance/' },
      { label: 'Health', href: null },
    ],
  },
  {
    icon: 'icon-home',
    title: 'Home Services',
    href: '/lead-generation/home-services/',
    items: [{ label: 'Roofing' }, { label: 'Solar' }, { label: 'Windows' }],
  },
  {
    icon: 'icon-finance',
    title: 'Finance',
    href: '/lead-generation/finance/',
    items: [{ label: 'Loans' }, { label: 'HELOC' }, { label: 'Reverse mortgage' }],
  },
];
---

<BaseLayout
  title="Lead Generation by Vertical — Calma"
  description="The verticals Calma generates, qualifies, and delivers leads for — auto and home insurance, home services, and financial services. Compliance-first performance lead generation."
  canonical="https://calma.io/lead-generation/"
  ogTitle="Lead Generation by Vertical"
  ogDescription="The verticals Calma generates, qualifies, and delivers leads for."
  useBlogCss={true}
>
  <IconSprite />
  <Header />

  <main id="main-content">
    <div class="article-page">
      <div class="container">

        <Breadcrumb items={[{ label: 'Lead Generation' }]} />

        <PageHero title="Lead Generation by Vertical" subtitle="The verticals we generate, qualify, and deliver leads for" />

        <div class="services-grid vhub-grid">
          {groups.map((g) => (
            <div class="service-card">
              <div class="service-head">
                <div class="service-icon">
                  <svg width="18" height="18" aria-hidden="true"><use href={`#${g.icon}`} /></svg>
                </div>
                {g.href ? (
                  <a class="service-title text-link" href={g.href}>{g.title}</a>
                ) : (
                  <h2 class="service-title">{g.title}</h2>
                )}
              </div>
              <ul class="service-list">
                {g.items.map((it) => (
                  <li>
                    {it.href ? (
                      <a class="text-link" href={it.href}>{it.label}</a>
                    ) : (
                      it.label
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <div class="vhub-outro">
          <p>
            Every vertical runs on its own buyer dynamics, compliance rules, and creative
            playbook — so we build dedicated systems for each rather than a one-size-fits-all
            funnel. Open a vertical to see how we generate, qualify, and deliver its leads, or
            <a href="/contacts/" class="text-link">get in touch</a> to talk through a custom program.
          </p>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  /* Linked items use the shared .text-link accent style. */
  .vhub-outro {
    max-width: 680px;
    margin: var(--space-xl) auto 0;
    text-align: center;
  }
  .vhub-outro p {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-muted);
  }
  /* On the homepage teaser the service-card sub-lists collapse on mobile, but
     here those items are LINKS to the vertical pages — keep them expanded so the
     pages stay reachable on mobile, stacked in a column like desktop. */
  @media (max-width: 768px) {
    .vhub-grid :global(.service-list) {
      display: block;
    }
    .vhub-grid :global(.service-head) {
      margin-bottom: var(--space-md);
      padding-bottom: var(--space-md);
      border-bottom: 1px solid var(--border-default);
    }
  }
</style>
